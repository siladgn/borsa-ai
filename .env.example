# Piyasa Veri API Anahtarları (Opsiyonel)
# ALPHA_VANTAGE_API_KEY=buraya_api_key
# FINNHUB_API_KEY=buraya_api_key
CRYPTOPANIC_API_KEY=buraya_cryptopanic_api_key # https://cryptopanic.com/developers/api/

# Binance API Ayarları (Gerçek işlem için)
BINANCE_API_KEY=buraya_api_keyini_yaz
