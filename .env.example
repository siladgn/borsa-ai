# Risk Yönetimi
TOPLAM_BAKIYE=1000
ISLEM_BASI_RISK=0.02

# Dashboard "İşleme gir" niyet dosyası en fazla kaç saniye sonra yok sayılsın (replay önleme)
# UI_INTENT_MAX_AGE_SEC=300

# Paper Trading (Gerçek işlem için False yap)
PAPER_TRADING=True
# PAPER_TRADING=False iken tarama sinyaliyle otomatik Binance vadeli (False: sadece dashboard niyeti)
# AUTO_BINANCE_TRADING=true
PAPER_START_BALANCE=1000
PAPER_MAX_OPEN_POSITIONS=5
